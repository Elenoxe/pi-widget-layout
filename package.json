{
  "name": "@eleno/pi-widget-layout",
  "type": "module",
  "version": "0.2.0",
  "description": "Deterministic layout control for Pi extension widgets.",
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elenoxe/pi-widget-layout.git"
  },
  "homepage": "https://github.com/Elenoxe/pi-widget-layout#readme",
  "bugs": {
    "url": "https://github.com/Elenoxe/pi-widget-layout/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "widgets",
    "layout"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "prepare": "bun run husky",
    "prepublishOnly": "bun run test && bun run check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "prettier": "3.9.8",
    "typescript": "^7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write --ignore-unknown",
      "oxlint --fix"
    ],
    "*.{json,jsonc,yml,yaml,md}": "prettier --write --ignore-unknown"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
